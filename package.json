{
  "name": "copy-lgtm",
  "displayName": "Copy LGTM",
  "version": "3.1.0",
  "description": "Extension that allows you to place a button on the GitHub pull request screen that allows you to copy LGTM images.",
  "author": "hayato",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "generate:images": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generateImages.mts",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@plasmohq/messaging": "0.7.2",
    "@plasmohq/storage": "1.15.0",
    "@radix-ui/react-popover": "1.1.23",
    "axios": "1.19.0",
    "plasmo": "0.90.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/chrome": "0.2.6",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "dotenv": "17.4.2",
    "sharp": "0.35.3",
    "typescript": "7.0.2"
  },
  "manifest": {
    "host_permissions": [
      "https://github.com/*"
    ]
  }
}
