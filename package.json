{
  "name": "copy-lgtm",
  "displayName": "Copy LGTM",
  "version": "3.0.2",
  "description": "Extension that allows you to place a button on the GitHub pull request screen that allows you to copy LGTM images.",
  "author": "hayato",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "generate:images": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/generateImages.mts",
    "lint": "biome check .",
    "fix": "biome check --write ."
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-popover": "^1.1.1",
    "axios": "^1.12.2",
    "plasmo": "0.90.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@types/chrome": "0.1.24",
    "@types/node": "24.9.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "dotenv": "^17.2.3",
    "sharp": "^0.33.5",
    "typescript": "5.9.3"
  },
  "manifest": {
    "host_permissions": [
      "https://github.com/*",
      "https://raw.githubusercontent.com/*"
    ]
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.32.6": ">=0.32.6",
      "msgpackr@<1.10.1": ">=1.10.1",
      "@babel/traverse@<7.23.2": ">=7.23.2",
      "protobufjs@>=7.0.0 <7.2.5": ">=7.2.5",
      "svelte@<4.2.19": ">=4.2.19"
    }
  }
}
